---
import Logo from "./Logo.astro";

const columns = [
  {
    title: "Company",
    links: [
      { label: "Who We Are", href: "#who-we-are" },
      { label: "Sustainability", href: "#sustainability" },
      { label: "Countries of Operation", href: "#countries" },
    ],
  },
  {
    title: "Products",
    links: [
      { label: "Used & Recovered Oils", href: "/products/waste-oils/" },
      { label: "Vegetable Oils", href: "/products/vegetable-oils/" },
      { label: "Animal Fats", href: "/products/animal-fats/" },
    ],
  },
  {
    title: "Contact",
    links: [{ label: "Get in Touch", href: "#contact" }],
  },
];

const socials = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/",
    path: "M4.5 4.5a1.75 1.75 0 113.5 0 1.75 1.75 0 01-3.5 0zM5 8.75h3V19H5V8.75zM10.5 8.75h2.9v1.42h.04c.4-.76 1.4-1.56 2.88-1.56 3.08 0 3.65 2.03 3.65 4.66V19h-3v-4.97c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.92 1.3-1.92 2.63V19h-3V8.75z",
  },
  {
    label: "X",
    href: "https://x.com/",
    path: "M4 4l7.5 9.4L4.3 20H6l6.3-5.9L17.5 20H20l-8-9.9L19.2 4h-1.7l-5.8 5.4L6.5 4H4z",
  },
  {
    label: "Email",
    href: "mailto:info@goldentie.africa",
    path: "M4 6h16v12H4V6zm0 0l8 6 8-6",
  },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo label="Feedstock Trade" />
      <p class="footer-tagline">A Golden Tie subsidiary — physical trading of biodiesel feedstocks.</p>

      <div class="footer-socials">
        {
          socials.map((social) => (
            <a href={social.href} class="social-link" aria-label={social.label} target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={social.path} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer-columns">
      {
        columns.map((column) => (
          <div class="footer-column">
            <h4>{column.title}</h4>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="footer-column">
        <h4>Reach Us</h4>
        <ul class="footer-contact">
          <li>Nairobi, Kenya</li>
          <li><a href="tel:+27000000000">+254759080224</a></li>
          <li><a href="mailto:info@goldentie.africa">info@goldentie.africa</a></li>
          <li><a href="mailto:goldentieltd@gmail.com">goldentieltd@gmail.com</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {new Date().getFullYear()} Golden Tie — Biodiesel Feedstock Trading. All rights reserved.</p>
      <a href="https://goldentie.africa" class="footer-parent-link">Part of the Golden Tie group →</a>
    </div>
  </div>
</footer>

<style>
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-8);
    padding: var(--space-12) var(--space-4);
  }

  .footer-brand :global(.logo-container) {
    width: fit-content;
  }

  .footer-tagline {
    color: var(--color-footer-ink);
    opacity: 0.7;
    margin-top: var(--space-3);
    max-width: 32ch;
  }

  .footer-socials {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-footer-line);
    color: var(--color-footer-ink);
  }

  .social-link:hover {
    border-color: var(--color-accent);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .footer-column h4 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-footer-ink);
    margin-bottom: var(--space-3);
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-column a,
  .footer-contact li {
    color: var(--color-footer-ink);
    opacity: 0.75;
    font-size: 0.9375rem;
  }

  .footer-column a:hover {
    opacity: 1;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-footer-line);
  }

  .footer-bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
  }

  .footer-bottom-inner p {
    color: var(--color-footer-ink);
    opacity: 0.6;
    font-size: 0.8125rem;
    margin: 0;
  }

  .footer-parent-link {
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }

    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-brand :global(.logo-container) {
      width: fit-content;
    }

    .footer-socials {
      justify-content: center;
    }
  }

  @media (max-width: 520px) {
    .footer-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
