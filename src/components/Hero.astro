---
import ProgressiveImage from "./ProgressiveImage.astro";
import heroImage from "../assets/images/hero-image.png";

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  image?: ImageMetadata;
}

const {
  title = "Trusted Trading of Biodiesel Feedstocks, Worldwide",
  subtitle = "Golden Tie's Biodiesel Feedstock Trading arm sources and moves biofuels, waste feedstocks, and feed-grade by-products, connecting suppliers and refiners across global markets.",
  ctaText = "Get in Touch",
  ctaHref = "#contact",
  image = heroImage,
} = Astro.props;
---

<section class="hero">
  <ProgressiveImage
    class="hero-image"
    src={image}
    alt=""
    width={image.width}
    height={image.height}
    layout="full-width"
    priority
  />
  <div class="hero-scrim"></div>

  <div class="hero-content container">
    <h1>{title}</h1>
    <p>{subtitle}</p>
    <a class="btn btn-primary" href={ctaHref}>{ctaText}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  :global(.hero-image) {
    position: absolute !important;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.82) 0%,
      rgba(0, 0, 0, 0.35) 55%,
      rgba(0, 0, 0, 0.15) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: var(--space-8) var(--space-4) var(--space-12);
    max-width: 60rem;
    margin-left: 8rem;
  }

  .hero-content h1 {
    color: #fff;
  }

  .hero-content p {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-lg);
    margin-top: var(--space-3);
    max-width: 38rem;
  }

  .hero-content .btn {
    margin-top: var(--space-4);
  }

  @media (max-width: 860px) {
    .hero-content {
      margin-left: 0;
      max-width: none;
    }
  }
</style>
