---
import { Image } from "astro:assets";
import kenyaFlag from "../assets/icons/flags/kenya.png";
import ugandaFlag from "../assets/icons/flags/uganda.png";
import tanzaniaFlag from "../assets/icons/flags/tanzania.png";
import rwandaFlag from "../assets/icons/flags/rwanda.png";
import burundiFlag from "../assets/icons/flags/burundi.png";

const countries = [
  { name: "Kenya", flag: kenyaFlag },
  { name: "Uganda", flag: ugandaFlag },
  { name: "Tanzania", flag: tanzaniaFlag },
  { name: "Rwanda", flag: rwandaFlag },
  { name: "Burundi", flag: burundiFlag },
];
---

<section id="countries" class="section section-alt countries">
  <div class="container">
    <span class="eyebrow">Countries of Operation</span>
    <h2>Trading across East Africa's feedstock markets</h2>
    <p class="countries-intro">
      Our counterparties span producers, refiners, and buyers across East
      Africa, backed by logistics partners who move product where it's needed.
    </p>

    <div class="countries-pills">
      {
        countries.map((country) => (
          <span class="country-pill">
            <Image class="country-flag" src={country.flag} alt="" width={20} height={20} />
            <span>{country.name}</span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .countries-intro {
    max-width: 40ch;
    margin-top: var(--space-2);
  }

  .countries-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .country-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .country-pill :global(.country-flag) {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
