---
const regions = [
  {
    name: "Africa",
    countries: ["South Africa", "Kenya", "Nigeria", "Egypt"],
  },
  {
    name: "Europe",
    countries: ["Netherlands", "Spain", "Germany", "Italy"],
  },
  {
    name: "Middle East",
    countries: ["UAE", "Saudi Arabia"],
  },
  {
    name: "Asia",
    countries: ["Malaysia", "Indonesia", "Singapore"],
  },
];
---

<section id="countries" class="section section-alt countries">
  <div class="container">
    <span class="eyebrow">Countries of Operation</span>
    <h2>Trading across a global feedstock network</h2>
    <p class="countries-intro">
      Our counterparties span producers, refiners, and buyers across four
      continents, backed by logistics partners who move product where it's needed.
    </p>

    <div class="countries-grid">
      {
        regions.map((region) => (
          <div class="capsule region-card">
            <h3>{region.name}</h3>
            <ul class="region-list">
              {region.countries.map((country) => (
                <li>{country}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .countries-intro {
    max-width: 40ch;
    margin-top: var(--space-2);
  }

  .countries-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .region-card {
    text-align: left;
  }

  .region-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .region-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .region-list li {
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
  }

  @media (max-width: 860px) {
    .countries-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .countries-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
