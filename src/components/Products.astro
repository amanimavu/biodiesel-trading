---
import ProgressiveImage from "./ProgressiveImage.astro";
import { products as groups } from "../data/products";
import arrowOutward from "../assets/icons/arrow_outward.svg?raw";
---

<section id="products" class="section section-alt products">
  <div class="container">
    <span class="eyebrow">Products We Trade</span>
    <h2>Commodities moving through our network</h2>
    <p class="products-intro">
      We source raw feedstocks directly from producers and collectors, and sell
      them on to refiners and buyers — with the documentation and traceability
      physical trade requires.
    </p>

    <div class="products-grid">
      {
        groups.map((group) => (
          <a
            id={group.id}
            class="card-photo product-card"
            href={`/products/${group.slug}/`}
          >
            {
              group.image && (
                <ProgressiveImage
                  class="card-photo-media"
                  src={group.image}
                  alt=""
                  width={group.image.width}
                  height={Math.round((group.image.width * 4) / 3)}
                  layout="full-width"
                />
              )
            }
            <div class="card-photo-content">
              <h3>
                {group.title}
                <span class="product-arrow" aria-hidden="true" set:html={arrowOutward} />
              </h3>
              <p>{group.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .products-intro {
    max-width: 40ch;
    margin-top: var(--space-2);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .product-card {
    display: block;
    background: linear-gradient(135deg, var(--color-ink) 0%, var(--color-ink-soft) 100%);
  }

  :global(.card-photo-media) {
    width: 100%;
    height: 100%;
    transition: transform 0.3s ease;
  }

  .product-card:hover :global(.card-photo-media) {
    transform: scale(1.05);
  }

  .product-card h3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .product-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1.5px solid #fff;
    color: #fff;
    transition: transform 0.15s ease;
  }

  .product-arrow :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .product-card:hover .product-arrow {
    transform: translate(3px, -3px);
  }

  @media (max-width: 860px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
