---
import logoMarkUrl from "../assets/images/golden-tie-logo.svg?url"

const {label, compact = false} = Astro.props
---

<div class:list={["logo-container", {compact}]}>
    <img class="logo-mark" src={logoMarkUrl} alt="" />
    <div class="logo-footer">
        <span class="decorator left"></span>
        <span class="label">{label?.toUpperCase() ?? "TIPPING"}</span>
        <span  class="decorator right"></span>
    </div>
</div>
<style>
    .logo-container{
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .logo-mark{
        width: 100px;
        height: auto;
    }

    .logo-footer{
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .decorator{
        display: block;
        width: 50px;
        height: 3px;
        background: linear-gradient(to bottom, #F9E322, #F9BD11, #C98200);
    }

    .right{
        /* flat side on the left (x=0): rounded to a full cap, tip stays sharp */
        clip-path: path("M2.5,0.12 L50,2.5 L2.5,4.88 Q0,5 0,2.5 Q0,0 2.5,0.12 Z");
    }

    .left{
        /* flat side on the right (x=50): rounded to a full cap, tip stays sharp */
        clip-path: path("M47.5,0.12 L0,2.5 L47.5,4.88 Q50,5 50,2.5 Q50,0 47.5,0.12 Z");
    }

    .label{
        font-size: 0.8rem;
        font-weight: bolder;
        color: var(--color-ink);
    }

    .logo-container.compact{
        flex-direction: row;
        gap: 0.5rem;
    }

    .logo-container.compact .logo-mark{
        width: 40px;
        height: auto;
    }

    .logo-container.compact .logo-footer{
        gap: 6px;
    }

    .logo-container.compact .decorator{
        width: 20px;
        height: 3px;
    }

    .logo-container.compact .label{
        font-size: 0.6rem;
    }
</style>