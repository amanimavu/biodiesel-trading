{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "compatibility_date": "2026-08-11",
    "compatibility_flags": ["global_fetch_strictly_public"],
    "name": "biodiesel-trading",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // Required so worker/csp-nonce.mjs runs on HTML responses. Without this the
        // asset layer serves pages directly and never reaches the Worker.
        "run_worker_first": true,
    },
    "observability": {
        "enabled": true,
    },
    "vars": {
        "CONTACT_RECIPIENTS": ["contact@goldentie.africa"],
        "CONTACT_CC": ["biofeedstocktrader@gmail.com"],
        "CONTACT_FROM_ADDRESS": "contact@goldentie.africa",
    },
}
